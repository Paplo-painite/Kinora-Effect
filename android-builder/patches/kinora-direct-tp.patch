@@ -591,6 +591,25 @@ impl EffectcraftApp {
             raw_input.events.extend(self.synthetic.drain(..n));
         }
     }
+
+    /// Queue one Android TP event directly for egui. This bypasses Java View dispatch, which
+    /// GameActivity does not reliably forward to its native input queue.
+    pub fn push_virtual_pointer_event(&mut self, x: f32, y: f32, button: u8, pressed: bool) {
+        let pointer_button = match button {
+            0 => egui::PointerButton::Primary,
+            1 => egui::PointerButton::Middle,
+            2 => egui::PointerButton::Secondary,
+            _ => return,
+        };
+        let pos = egui::pos2(x, y);
+        self.synthetic.push(egui::Event::PointerMoved(pos));
+        self.synthetic.push(egui::Event::PointerButton {
+            pos,
+            button: pointer_button,
+            pressed,
+            modifiers: egui::Modifiers::NONE,
+        });
+    }

