+    /// A narrow window shows one full-size panel at a time. The saved desktop dock and floating
+    /// groups remain untouched, so resizing back restores the user's workspace exactly.
+    fn mobile_area(&mut self, ui: &mut egui::Ui, body: Rect) {
+        let nav_h = MOBILE_TAB_BAR_HEIGHT.min(body.height());
+        let nav_rect = Rect::from_min_max(pos2(body.min.x, body.max.y - nav_h), body.max);
+        let panel_rect = Rect::from_min_max(body.min, pos2(body.max.x, nav_rect.min.y));
+        let mut active = self.mobile_panel;
+        let mut chosen = None;
+
+        let t = self.tokens;
+        ui.painter().rect_filled(nav_rect, 0.0, t.header_bg);
+        ui.painter().line_segment([nav_rect.left_top(), nav_rect.right_top()], Stroke::new(1.0, t.separator));
+        let mut nav = ui.new_child(egui::UiBuilder::new().max_rect(nav_rect).id_salt("mobile-panel-tabs"));
+        nav.set_clip_rect(nav_rect.intersect(ui.clip_rect()));
+
+        let margin = 4.0;
+        let gap = 2.0;
+        let available = (nav_rect.width() - margin * 2.0).max(0.0);
+        let tab_w = ((available - gap * (MOBILE_PRIMARY_TABS.len() - 1) as f32) / MOBILE_PRIMARY_TABS.len() as f32).max(0.0);
+        let mut x = nav_rect.min.x + margin;
+        for (panel, label) in MOBILE_PRIMARY_TABS {
+            let rect = Rect::from_min_size(pos2(x, nav_rect.min.y + 4.0), vec2(tab_w, (nav_h - 8.0).max(0.0)));
+            let response = nav.put(rect, egui::Button::selectable(active == panel, label)).on_hover_text(panel.title());
+            self.auto.add_response(&format!("mobile.tab.{}", panel.id()), &response, panel.title());
+            if response.clicked() {
+                chosen = Some(panel);
+            }
+            x += tab_w + gap;
+        }
+
+        if let Some(panel) = chosen {
+            active = panel;
+            self.mobile_panel = panel;
+            self.ui.focused = panel;
+        }
+        self.dock_rects = vec![(active, panel_rect)];
+        self.panel_body(ui, active, panel_rect);
+    }
