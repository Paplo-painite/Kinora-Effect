+/// Compact controls for narrow windows; the full desktop toolbar remains unchanged at wide sizes.
+pub fn show_mobile(app: &mut EffectcraftApp, ui: &mut egui::Ui, rect: Rect) {
+    let t = app.tokens;
+    ui.painter().rect_filled(rect, 0.0, t.header_bg);
+    ui.painter().line_segment([rect.left_bottom(), rect.right_bottom()], Stroke::new(1.0, t.app_bg));
+    let mut row = ui.new_child(
+        egui::UiBuilder::new().max_rect(rect.shrink2(vec2(8.0, 2.0))).layout(egui::Layout::left_to_right(egui::Align::Center)).id_salt("mobile-header"),
+    );
+    row.set_clip_rect(rect.intersect(ui.clip_rect()));
+
+    let menu = row.menu_button("Menu", |ui| {
+        ui.set_min_width(200.0);
+        crate::menus::mobile_menu_items(app, ui);
+    });
+    app.auto.add_response("mobile.menu", &menu.response, "Application menu");
+
+    let home = row.button("Home");
+    app.auto.add_response("mobile.home", &home, "Home");
+    if home.clicked() {
+        app.ui.start_screen = !app.ui.start_screen;
+    }
+
+    row.add_space(4.0);
+    let tool = app.ui.tool;
+    let tool_label = tool.label();
+    let picker = row.menu_button(tool_label, |ui| {
+        ui.set_min_width(200.0);
+        egui::ScrollArea::vertical().max_height(360.0).show(ui, |ui| {
+            for tool in Tool::ALL {
+                let choice = ui.selectable_label(app.ui.tool == tool, tool.label());
+                app.auto.add_response(&format!("mobile.tool.{tool:?}"), &choice, tool.label());
+                if choice.clicked() {
+                    app.ui.tool = tool;
+                    ui.close();
+                }
+            }
+        });
+    });
+    app.auto.add_response("mobile.tool", &picker.response, tool_label);
+}
