+/// The same application menus, nested under a compact phone-friendly menu button.
+pub(crate) fn mobile_menu_items(app: &mut EffectcraftApp, ui: &mut egui::Ui) {
+    let ctx = ui.ctx().clone();
+    let mut clicked: Option<(String, Value)> = None;
+    let mut nav = crate::menu_keys::Nav::default();
+    for node in effectcraft_engine::menus::menu_bar() {
+        if let MenuNode::Submenu { label, children } = node {
+            let display_label = crate::i18n::label(app, "", label);
+            let response = ui.menu_button(display_label, |ui| {
+                ui.set_min_width(if label == "Effect" { 200.0 } else { 280.0 });
+                crate::widgets::menu_scroll(ui, |ui| menu_nodes(app, ui, children, &mut clicked, &mut nav, 0));
+            });
+            nav.top(&response.response);
+            app.auto.add_response(&format!("mobile.menu.{label}"), &response.response, label);
+        }
+    }
+    crate::menu_keys::handle(&ctx, &nav);
+    if let Some((id, params)) = clicked.map(|(id, params)| menu_choice(app, id, params))
+        && let Err(error) = invoke(app, &ctx, &id, if params.is_null() { json!({}) } else { params })
+    {
+        app.ui.status = error;
+    }
+}
