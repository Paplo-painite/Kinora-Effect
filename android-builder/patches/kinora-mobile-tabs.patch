@@ -0,0 +1,85 @@
+use effectcraft_engine::Session;
+use effectcraft_ui_egui::EffectcraftApp;
+use egui::{Event, Pos2, Rect, pos2, vec2};
+use egui_kittest::Harness;
+
+fn rect(h: &Harness<'_, EffectcraftApp>, id: &str) -> Rect {
+    let element = h
+        .state()
+        .auto
+        .elements
+        .iter()
+        .chain(h.state().auto.previous.iter())
+        .find(|element| element.id == id)
+        .unwrap_or_else(|| panic!("no automated UI element {id}"))
+        .clone();
+    Rect::from_min_size(pos2(element.rect[0], element.rect[1]), vec2(element.rect[2], element.rect[3]))
+}
+
+fn click(h: &mut Harness<'_, EffectcraftApp>, at: Pos2) {
+    h.event(Event::PointerMoved(at));
+    h.step();
+    h.event(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });
+    h.step();
+    h.event(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });
+    h.run_steps(2);
+}
+
+#[test]
+fn narrow_window_uses_mobile_tabs_and_keeps_the_desktop_workspace_unchanged() {
+    let mut h = Harness::builder().with_size(vec2(390.0, 844.0)).build_eframe(|_| EffectcraftApp::new(Session::default()));
+    h.run_steps(3);
+    let dock_before = h.state().ui.dock.clone();
+    let floating_before = h.state().ui.floating.clone();
+
+    assert!(h.state().auto.find("mobile.menu").is_some());
+    assert!(h.state().auto.find("mobile.home").is_some());
+    assert!(h.state().auto.find("mobile.tool").is_some());
+    assert!(h.state().auto.find("menu.File").is_none());
+    assert!(h.state().auto.find("mobile.tab.Composition").is_some());
+    assert!(h.state().auto.find("mobile.tab.Project").is_some());
+    assert!(h.state().auto.find("panel.Composition").is_some());
+    assert!(h.state().auto.find("panel.Project").is_none());
+
+    let menu_button = rect(&h, "mobile.menu").center();
+    click(&mut h, menu_button);
+    assert!(h.state().auto.elements.iter().any(|element| element.id == "mobile.menu.File"));
+
+    let project_tab = rect(&h, "mobile.tab.Project").center();
+    click(&mut h, project_tab);
+    assert!(h.state().auto.find("panel.Project").is_some());
+    assert!(h.state().auto.find("panel.Composition").is_none());
+    assert_eq!(h.state().ui.focused, effectcraft_ui_egui::dock::PanelKind::Project);
+    assert_eq!(h.state().ui.dock, dock_before);
+    assert_eq!(h.state().ui.floating, floating_before);
+
+    assert!(h.state().auto.find("mobile.tab.Preview").is_some());
+    let preview_tab = rect(&h, "mobile.tab.Preview").center();
+    click(&mut h, preview_tab);
+    assert_eq!(h.state().ui.focused, effectcraft_ui_egui::dock::PanelKind::Preview);
+    assert!(h.state().auto.find("panel.Preview").is_some());
+    assert_eq!(h.state().ui.dock, dock_before);
+    assert_eq!(h.state().ui.floating, floating_before);
+
+    h.set_size(vec2(1280.0, 800.0));
+    h.run_steps(3);
+    assert!(h.state().auto.find("mobile.tab.Composition").is_none());
+    assert!(h.state().auto.find("panel.tab.Composition").is_some());
+    assert_eq!(h.state().ui.dock, dock_before);
+
+    h.set_size(vec2(390.0, 844.0));
+    h.run_steps(3);
+    assert!(h.state().auto.find("mobile.tab.Preview").is_some());
+    assert!(h.state().auto.find("panel.Preview").is_some());
+    assert_eq!(h.state().ui.dock, dock_before);
+}
+
+#[test]
+fn wide_window_keeps_the_desktop_dock_instead_of_mobile_tabs() {
+    let mut h = Harness::builder().with_size(vec2(1280.0, 800.0)).build_eframe(|_| EffectcraftApp::new(Session::default()));
+    h.run_steps(3);
+
+    assert!(h.state().auto.find("mobile.tab.Composition").is_none());
+    assert!(h.state().auto.find("panel.tab.Composition").is_some());
+    assert!(h.state().auto.find("panel.tab.Project").is_some());
+}
