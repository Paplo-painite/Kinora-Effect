+
+/// Resolve the TP override selected in the header. `None` means contextual/automatic mode.
+pub fn tp_cursor_icon(mode: &str) -> Option<egui::CursorIcon> {
+    Some(match mode {
+        "arrow" => egui::CursorIcon::Default,
+        "hand" => egui::CursorIcon::PointingHand,
+        "crosshair" => egui::CursorIcon::Crosshair,
+        "text" => egui::CursorIcon::Text,
+        "zoom-in" => egui::CursorIcon::ZoomIn,
+        "zoom-out" => egui::CursorIcon::ZoomOut,
+        "grab" => egui::CursorIcon::Grab,
+        _ => return None,
+    })
+}
