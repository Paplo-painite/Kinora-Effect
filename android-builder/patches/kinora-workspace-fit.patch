diff --git a/crates/ui-egui/tests/ui_kinora_fit.rs b/crates/ui-egui/tests/ui_kinora_fit.rs
new file mode 100644
index 0000000..6d37e17
--- /dev/null
+++ b/crates/ui-egui/tests/ui_kinora_fit.rs
@@ -0,0 +1,56 @@
+use effectcraft_engine::Session;
+use effectcraft_ui_egui::{EffectcraftApp, dock::PanelKind};
+use egui::{Event, Pos2, pos2};
+use egui_kittest::Harness;
+
+fn harness(width: f32) -> Harness<'static, EffectcraftApp> {
+    let mut h = Harness::builder().with_size(egui::vec2(width, 480.0)).build_eframe(|_| EffectcraftApp::new(Session::default()));
+    h.run_steps(3);
+    h
+}
+
+fn click(h: &mut Harness<'_, EffectcraftApp>, id: &str) {
+    let e = h.state().auto.find(id).unwrap_or_else(|| panic!("missing {id}")).clone();
+    let at: Pos2 = pos2(e.rect[0] + e.rect[2] / 2.0, e.rect[1] + e.rect[3] / 2.0);
+    h.input_mut().events.push(Event::PointerMoved(at));
+    h.input_mut().events.push(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });
+    h.step();
+    h.input_mut().events.push(Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });
+    h.run_steps(2);
+}
+
+#[test]
+fn header_quick_controls_change_and_fit_ui_scale_and_workspace() {
+    let mut h = harness(720.0);
+    assert!(h.state().auto.find("header.uiScale.decrease").is_some());
+    assert!(h.state().auto.find("header.uiScale.increase").is_some());
+    assert!(h.state().auto.find("header.uiScale.fitWorkspace").is_some());
+
+    click(&mut h, "header.uiScale.decrease");
+    assert_eq!(h.state().session.prefs.appearance.ui_scale, 90);
+    assert_eq!(h.ctx.zoom_factor(), 0.9);
+
+    click(&mut h, "header.uiScale.increase");
+    assert_eq!(h.state().session.prefs.appearance.ui_scale, 100);
+
+    click(&mut h, "header.uiScale.fitWorkspace");
+    let expected = (720.0_f32 / 9.0).round().clamp(50.0, 100.0) as u32;
+    assert_eq!(h.state().session.prefs.appearance.ui_scale, expected);
+    assert!((h.ctx.zoom_factor() - expected as f32 / 100.0).abs() < 0.001);
+    assert_eq!(h.state().ui.workspace, "Kinora Fit");
+    assert!(h.state().ui.dock.contains(PanelKind::Project));
+    assert!(h.state().ui.dock.contains(PanelKind::Composition));
+    assert!(h.state().ui.dock.contains(PanelKind::Timeline));
+    assert!(h.state().ui.dock.contains(PanelKind::Preview));
+}
+
+#[test]
+fn fit_workspace_never_scales_beyond_supported_limits() {
+    let mut small = harness(360.0);
+    click(&mut small, "header.uiScale.fitWorkspace");
+    assert_eq!(small.state().session.prefs.appearance.ui_scale, 50);
+
+    let mut large = harness(1800.0);
+    click(&mut large, "header.uiScale.fitWorkspace");
+    assert_eq!(large.state().session.prefs.appearance.ui_scale, 100);
+}
