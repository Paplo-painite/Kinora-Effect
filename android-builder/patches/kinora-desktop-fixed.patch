diff --git a/crates/ui-egui/tests/ui_desktop_fixed.rs b/crates/ui-egui/tests/ui_desktop_fixed.rs
new file mode 100644
index 00000000..586f3b40
--- /dev/null
+++ b/crates/ui-egui/tests/ui_desktop_fixed.rs
@@ -0,0 +1,35 @@
+use effectcraft_engine::Session;
+use effectcraft_ui_egui::EffectcraftApp;
+use egui::vec2;
+use egui_kittest::Harness;
+
+fn assert_desktop_layout(h: &Harness<'_, EffectcraftApp>) {
+    assert!(h.state().auto.find("mobile.menu").is_none());
+    assert!(h.state().auto.find("mobile.tool").is_none());
+    assert!(h.state().auto.find("mobile.tab.Composition").is_none());
+    assert!(h.state().auto.find("header.home").is_some());
+    assert!(h.state().auto.find("panel.tab.Composition").is_some());
+    assert!(h.state().auto.find("panel.tab.Project").is_some());
+}
+
+#[test]
+fn landscape_phone_keeps_desktop_header_and_dock() {
+    let mut h = Harness::builder().with_size(vec2(960.0, 480.0)).build_eframe(|_| EffectcraftApp::new(Session::default()));
+    h.run_steps(3);
+    let dock = h.state().ui.dock.clone();
+    let floating = h.state().ui.floating.clone();
+    assert_desktop_layout(&h);
+
+    h.set_size(vec2(1280.0, 800.0));
+    h.run_steps(3);
+    assert_desktop_layout(&h);
+    assert_eq!(h.state().ui.dock, dock);
+    assert_eq!(h.state().ui.floating, floating);
+}
+
+#[test]
+fn compact_window_does_not_switch_to_mobile_tabs() {
+    let mut h = Harness::builder().with_size(vec2(390.0, 844.0)).build_eframe(|_| EffectcraftApp::new(Session::default()));
+    h.run_steps(3);
+    assert_desktop_layout(&h);
+}
