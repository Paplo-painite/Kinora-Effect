+    s.state.project_selection = vec![effectcraft_engine::project::ItemId(footage)];
+    let mut h = Harness::builder().with_size(vec2(1600.0, 1000.0)).build_eframe(|_| EffectcraftApp::new(s));
+    h.run_steps(3);
+    click_id(&mut h, "viewer.empty.import");
+
+    let comp = h.state().session.active_comp().expect("selected footage opens in a composition");
+    assert_eq!((comp.width, comp.height, comp.duration.seconds()), (640, 360, 5.0));
+    assert_eq!(comp.layers.len(), 1);
+    assert_eq!(comp.layers[0].name, "Selected.mp4");
+    assert!(h.state().dialog.is_none(), "using selected footage should not reopen the file picker");
+}
