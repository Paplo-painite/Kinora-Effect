+/// The empty Composition viewer asks the import job to create one composition after the footage
+/// has been added and selected. Kept here so the background import and its UI completion are one
+/// atomic workflow; ordinary File ▸ Import remains unchanged.
+fn create_comp_from_imported_footage(s: &mut Session, r: &mut Value, p: &Value) {
+    if b_p(p, "createCompFromFootage") != Some(true) || r["comps"].as_array().is_some_and(|comps| !comps.is_empty()) {
+        return;
+    }
+    let selected: Vec<ItemId> = r["items"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter_map(Value::as_u64)
+        .map(ItemId)
+        .filter(|id| s.project.item(*id).is_some_and(|item| matches!(&item.kind, ItemKind::Footage(f) if f.kind != FootageKind::Data)))
+        .collect();
+    if selected.is_empty() {
+        if let Some(errors) = r.get_mut("errors").and_then(Value::as_array_mut) {
+            errors.push(Value::from("No visual or audio footage was imported; no composition was created."));
+        }
+        return;
+    }
+    s.state.project_selection = selected;
+    match s.execute("file.newCompFromSelection", json!({"single": true})) {
+        Ok(composition) => r["composition"] = composition,
+        Err(error) => {
+            if let Some(errors) = r.get_mut("errors").and_then(Value::as_array_mut) {
+                errors.push(Value::from(format!("Composition creation failed: {error}")));
+            }
+        }
+    }
 }
 
