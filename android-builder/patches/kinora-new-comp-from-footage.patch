+#[test]
+fn new_composition_from_footage_imports_the_picked_file_and_opens_it() {
+    let dir = std::env::temp_dir().join(format!("ec-ui-new-comp-from-footage-{}", std::process::id()));
+    let _ = std::fs::remove_dir_all(&dir);
+    std::fs::create_dir_all(&dir).unwrap();
+    let path = dir.join("clip.png");
+    std::fs::write(&path, b"").unwrap();
+
+    let mut s = Session::default();
+    s.importer = Some(Arc::new(Stills));
+    let mut h = Harness::builder().with_size(vec2(1600.0, 1000.0)).build_eframe(|_| EffectcraftApp::new(s));
+    h.run_steps(3);
+    let picked = path.to_string_lossy().to_string();
+    h.state_mut().hooks.pick_files = Some(Box::new(move |_| vec![picked.clone()]));
+    click_id(&mut h, "viewer.empty.import");
+
+    step_until(&mut h, |h| h.state().session.active_comp().is_some());
+    let comp = h.state().session.active_comp().expect("the picked footage opens in a composition");
+    assert_eq!((comp.width, comp.height), (64, 32));
+    assert_eq!(comp.layers.len(), 1);
+    assert_eq!(comp.layers[0].name, "clip.png");
+    assert!(matches!(&comp.layers[0].source, effectcraft_engine::project::LayerSource::Footage { .. }));
+    let _ = std::fs::remove_dir_all(&dir);
+}
+
